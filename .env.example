DATABASE_URL="file:./dev.db"
# On Vercel, SQLite auto-uses file:/tmp/muler.db and creates tables on first request.
# For durable production history, point DATABASE_URL at a hosted Postgres/Turso URL instead.
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://osi-azure-openai.services.ai.azure.com/openai/v1/responses"
AZURE_OPENAI_MODEL="gpt-5.4"
